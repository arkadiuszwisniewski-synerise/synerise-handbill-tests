# Synerise workspace API key (used to obtain a bearer token). Copy this file to
# .env (gitignored) and put your own key here — never commit a real key.
SYNERISE_API_KEY=your-workspace-api-key

# Synerise API base URL.
SYNERISE_API_BASE=https://api.synerise.com

# Local server port.
PORT=3000

# Optional: hash of the "promotion" tag directory used by the tag picker.
# Left empty the server discovers it per workspace on first use and caches it.
# PROMOTION_TAG_DIRECTORY_HASH=
